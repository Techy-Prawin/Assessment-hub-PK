# ==========================================
# PK Assessment Hub — Environment Variables Template
# Copy this file to .env and configure values
# ==========================================

# ----------------------------------------------------
# 1. DATABASE CONFIGURATION (Required)
# ----------------------------------------------------
# For SQLite (local dev or persistent container with volume mounted to /prisma):
DATABASE_URL="file:./dev.db"

# For PostgreSQL (e.g., Supabase, Neon, Railway Postgres):
# DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# ----------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Required in Production)
# ----------------------------------------------------
# Minimum 32-character random string.
# Generate on Linux/macOS: openssl rand -hex 32
# Generate on Windows (Node): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# ----------------------------------------------------
# 3. AI QUESTION GENERATION & EVALUATION (Optional)
# ----------------------------------------------------
# Google Gemini API key from https://aistudio.google.com/
# OPTIONAL: If left blank or invalid, the platform automatically
# falls back to its built-in offline aptitude question generator.
GEMINI_API_KEY=""
AI_MODEL="gemini-1.5-flash"

# ----------------------------------------------------
# 4. RUNTIME ENVIRONMENT (Optional)
# ----------------------------------------------------
# NODE_ENV is set to "production" automatically by hosting providers on npm start
NODE_ENV="production"

