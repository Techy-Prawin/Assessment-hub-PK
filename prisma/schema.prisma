datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String        @id @default(cuid())
  name      String
  email     String        @unique
  password  String
  role      String        @default("USER") // "ADMIN" or "USER"
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  attempts  TestAttempt[]
}

model Question {
  id            String         @id @default(cuid())
  question      String
  topic         String
  difficulty    String         @default("MEDIUM") // "EASY", "MEDIUM", "HARD"
  options       String         // JSON string array of 4 options e.g. ["Option A", "Option B", ...]
  correctAnswer String         // exact matching option string or index
  explanation   String?
  marks         Int            @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  testQuestions TestQuestion[]
  userAnswers   UserAnswer[]
}

model Test {
  id            String         @id @default(cuid())
  title         String
  description   String?
  duration      Int            @default(30) // duration in minutes
  totalMarks    Int            @default(0)
  status        String         @default("DRAFT") // "DRAFT", "PUBLISHED", "ARCHIVED"
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  testQuestions TestQuestion[]
  attempts      TestAttempt[]
}

model TestQuestion {
  id         String   @id @default(cuid())
  testId     String
  questionId String
  order      Int      @default(0)
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([testId, questionId])
}

model TestAttempt {
  id              String       @id @default(cuid())
  userId          String
  testId          String
  startedAt       DateTime     @default(now())
  submittedAt     DateTime?
  score           Float        @default(0)
  totalQuestions  Int          @default(0)
  correctCount    Int          @default(0)
  wrongCount      Int          @default(0)
  unansweredCount Int          @default(0)
  percentage      Float        @default(0)
  status          String       @default("IN_PROGRESS") // "IN_PROGRESS", "COMPLETED", "EXPIRED"
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  test            Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers         UserAnswer[]
}

model UserAnswer {
  id             String      @id @default(cuid())
  attemptId      String
  questionId     String
  selectedAnswer String?
  isCorrect      Boolean     @default(false)
  marksAwarded   Float       @default(0)
  aiFeedback     String?
  attempt        TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

